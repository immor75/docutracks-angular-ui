{
  "name": "docutracks-angular-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "mock": "node mock/server.mjs",
    "start": "ng serve --proxy-config proxy.mock.json",
    "start:test-new": "ng serve --proxy-config proxy.test-new.json",
    "start:test-new-api": "ng serve -c api --proxy-config proxy.test-new-api.json",
    "build": "ng build --base-href /apps-next/",
    "test": "ng test",
    "lint": "ng lint",
    "preview": "node tools/serve-dist.mjs dist/docutracks-angular-ui/browser",
    "preview:test-new": "node tools/serve-dist.mjs dist/docutracks-angular-ui/browser --test-new"
  },
  "private": true,
  "packageManager": "npm@10.9.4",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@fontsource-variable/geologica": "^5.3.0",
    "@formio/js": "^5.7.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "flatpickr-formio": "^4.6.13-formio.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.22.3"
  }
}
